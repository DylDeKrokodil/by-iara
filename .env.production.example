# Copy to .env.production and replace every CHANGE_ME value.
# Keep .env.production on the server only; it is ignored by Git.

DOMAIN=iaragouveia.com
ACME_EMAIL=info@iaragouveia.com

POSTGRES_DB=by_iara
POSTGRES_USER=by_iara
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL
ADMIN_JWT_SECRET=CHANGE_ME_ADMIN_JWT_SECRET_AT_LEAST_32_BYTES_LONG
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
BOOKING_EMAIL_MAX_REQUESTS=5
CUSTOMER_ACCESS_EMAIL_MAX_REQUESTS=2
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_PAIR_MAX_FAILURES=5
ADMIN_LOGIN_IP_MAX_FAILURES=20

# Media is stored in the persistent service_media Docker volume on this server.
# The S3 settings can be filled later if object storage is enabled.
MEDIA_STORAGE_PROVIDER=filesystem
MEDIA_STORAGE_ROOT=/app/data/media
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=eu-central
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_PATH_STYLE_ACCESS=false
MEDIA_S3_KEY_PREFIX=production

# Enable only for the first successful deployment. After signing in, set this to
# false and remove INITIAL_ADMIN_PASSWORD from the file.
INITIAL_ADMIN_ENABLED=true
INITIAL_ADMIN_EMAIL=info@iaragouveia.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_UNIQUE_PASSWORD

BUSINESS_PHONE=CHANGE_ME_PUBLIC_BUSINESS_PHONE
BUSINESS_ADDRESS=Rua Vila do Seixal 5, 1.º direito, 2810-141 Almada, Portugal
BUSINESS_EMAIL=info@iaragouveia.com
GOOGLE_REVIEW_URL=https://g.page/r/CVzKM_-9IuRxEAE/review

# Example: Resend SMTP for application-generated notifications. This is separate
# from the info@ mailbox used by a person to send and receive normal email.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=CHANGE_ME_RESEND_API_KEY
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
NOTIFICATIONS_FROM_ADDRESS=Iara Gouveia <info@iaragouveia.com>

# Host path. Also copy these dumps to storage outside this server.
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
