meta {
  name: Admin Refresh
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/admin/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body?.accessToken) {
    bru.setEnvVar("accessToken", res.body.accessToken);
    bru.setEnvVar("refreshToken", res.body.refreshToken);
  }
}

tests {
  test("rotates the session", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessToken).to.be.a("string");
    expect(res.body.refreshToken).to.be.a("string");
    expect(res.body.admin.email).to.equal("admin@by-iara.local");
  });
}
