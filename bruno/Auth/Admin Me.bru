meta {
  name: Admin Me
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/admin/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns authenticated admin", function () {
    expect(res.status).to.equal(200);
    expect(res.body.email).to.equal("admin@by-iara.local");
    expect(res.body.role).to.equal("ADMIN");
  });
}
