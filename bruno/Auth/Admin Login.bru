meta {
  name: Admin Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@by-iara.local",
    "password": "ChangeMe123!"
  }
}

script:post-response {
  if (res.status === 200 && res.body?.accessToken) {
    bru.setEnvVar("accessToken", res.body.accessToken);
  }
}

tests {
  test("returns access token", function () {
    expect(res.status).to.equal(200);
    expect(res.body.tokenType).to.equal("Bearer");
    expect(res.body.admin.email).to.equal("admin@by-iara.local");
    expect(res.body.admin.role).to.equal("ADMIN");
    expect(res.body.accessToken).to.be.a("string");
    expect(res.body.accessToken.split(".")).to.have.length(3);
  });
}
