meta {
  name: Admin Confirm Reservation
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/admin/reservations/{{reservationId}}/confirm
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("confirms the reservation", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("CONFIRMED");
  });
}
