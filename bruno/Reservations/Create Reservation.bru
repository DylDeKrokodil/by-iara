meta {
  name: Create Reservation
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/reservations
  body: json
  auth: none
}

body:json {
  {
    "serviceId": "{{serviceId}}",
    "serviceVariantId": "{{serviceVariantId}}",
    "startsAt": "{{reservationStart}}",
    "customer": {
      "name": "Ana Costa",
      "email": "ana@example.com",
      "phone": "+351912345678"
    },
    "notes": "Booked via Bruno"
  }
}

script:post-response {
  if (res.status === 201 && res.body?.id) {
    bru.setEnvVar("reservationId", res.body.id);
  }
}

docs {
  Run `Auth > Admin Login`, `Services > Admin Create Service`, seed availability rules,
  then `Reservations > Bookable Slots` (captures the first free slot into reservationStart)
  before sending this request.
}

tests {
  test("creates a pending reservation", function () {
    expect(res.status).to.equal(201);
    expect(res.body.status).to.equal("PENDING");
    expect(res.body.durationMinutes).to.be.a("number");
    expect(res.body.price.amountCents).to.be.a("number");
    expect(res.body.customer.email).to.equal("ana@example.com");
  });
}
