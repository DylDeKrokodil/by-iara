meta {
  name: Admin Get Reservation
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/admin/reservations/{{reservationId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns the reservation", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getEnvVar("reservationId"));
  });
}
