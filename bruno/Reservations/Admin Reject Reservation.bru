meta {
  name: Admin Reject Reservation
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/admin/reservations/{{reservationId}}/reject
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Only valid from PENDING. Confirming first, then rejecting, returns 409 (illegal transition).
}

tests {
  test("rejects the reservation", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("REJECTED");
  });
}
