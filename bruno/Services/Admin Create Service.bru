meta {
  name: Admin Create Service
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/admin/services
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Massagem de tecido profundo",
    "description": "Pressao firme e focada para alivio de tensao",
    "featured": true,
    "sortOrder": 0,
    "translations": {
      "pt-PT": {
        "name": "Massagem de tecido profundo",
        "description": "Pressao firme e focada para alivio de tensao"
      },
      "en-US": {
        "name": "Deep Tissue Massage",
        "description": "Firm, focused pressure for tension relief"
      }
    },
    "variants": [
      { "durationMinutes": 30, "priceCents": 4500 },
      { "durationMinutes": 45, "priceCents": 6000 },
      { "durationMinutes": 60, "priceCents": 7500 }
    ]
  }
}

script:post-response {
  if (res.status === 201 && res.body?.id) {
    bru.setEnvVar("serviceId", res.body.id);
  }
}

tests {
  test("creates a service with variants", function () {
    expect(res.status).to.equal(201);
    expect(res.body.slug).to.be.a("string");
    expect(res.body.variants).to.have.length(3);
    expect(res.body.variants[0].price.currency).to.equal("EUR");
  });

  test("stores translations for both locales", function () {
    expect(res.body.translations["pt-PT"].name).to.equal("Massagem de tecido profundo");
    expect(res.body.translations["en-US"].name).to.equal("Deep Tissue Massage");
  });
}
