meta {
  name: Services List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/services
  body: none
  auth: none
}

tests {
  test("returns the public catalog", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
  });

  test("each service exposes translations", function () {
    if (res.body.length > 0) {
      expect(res.body[0].translations).to.be.an("object");
    }
  });
}
