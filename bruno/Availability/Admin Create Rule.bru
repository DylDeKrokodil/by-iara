meta {
  name: Admin Create Rule
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/admin/availability/rules
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "dayOfWeek": "MONDAY",
    "startTime": "09:00:00",
    "endTime": "17:00:00"
  }
}

script:post-response {
  if (res.status === 201 && res.body?.id) {
    bru.setEnvVar("ruleId", res.body.id);
  }
}

tests {
  test("creates a rule", function () {
    expect(res.status).to.equal(201);
    expect(res.body.id).to.be.a("string");
    expect(res.body.dayOfWeek).to.equal("MONDAY");
    expect(res.body.startTime).to.equal("09:00:00");
    expect(res.body.endTime).to.equal("17:00:00");
  });
}
