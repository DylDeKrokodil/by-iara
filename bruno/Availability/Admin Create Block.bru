meta {
  name: Admin Create Block
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/admin/availability/blocks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "startTime": "2026-07-06T12:00:00+02:00",
    "endTime": "2026-07-06T13:00:00+02:00",
    "reason": "Lunch break"
  }
}

script:post-response {
  if (res.status === 201 && res.body?.id) {
    bru.setEnvVar("blockId", res.body.id);
  }
}

tests {
  test("creates a block", function () {
    expect(res.status).to.equal(201);
    expect(res.body.id).to.be.a("string");
    expect(res.body.reason).to.equal("Lunch break");
  });
}
