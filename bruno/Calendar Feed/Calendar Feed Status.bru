meta {
  name: Calendar Feed Status
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/admin/calendar-feed
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns feed status", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("active");
  });
}
