meta {
  name: Health
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:8080
}

tests {
  test("returns UP", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("UP");
    expect(res.body.service).to.equal("by-iara-api");
  });
}
